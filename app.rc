1 ICON "src-media/logo.ico"

1 VERSIONINFO
FILEVERSION @VERSION_NUMBER@
PRODUCTVERSION @VERSION_NUMBER@
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "No Router-Mercy v@VERSION@\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "no-router-mercy\0"
            VALUE "OriginalFilename", "no-router-mercy.exe\0"
            VALUE "ProductName", "No Router-Mercy\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
